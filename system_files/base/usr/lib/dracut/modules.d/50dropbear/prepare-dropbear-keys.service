[Unit]
Description=Prepare Dropbear keys from /boot
DefaultDependencies=no
Before=dropbear-ssh.service
Requires=dev-disk-by\x2dlabel-boot.device
After=dev-disk-by\x2dlabel-boot.device

[Install]
WantedBy=dropbear-ssh.service

[Service]
Type=oneshot
ExecStart=/bin/sbin/prepare-dropbear-keys.sh
RemainAfterExit=yes
